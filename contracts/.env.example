# Copy to contracts/.env and fill in. Never commit .env or private keys.

# Deployer (hex, with or without 0x). Must hold ETH on the target chain.
PRIVATE_KEY=

# RPCs
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# Constructor: fee in wei (no USD in Solidity). Sepolia default ~0.00002 ETH.
ENTRY_FEE_WEI=20000000000000

# Treasury (EOA or multisig). Empty = deployer address.
TREASURY_ADDRESS=

# Optional Basescan / Etherscan API key for source verification
BASESCAN_API_KEY=

# --- Weekly theme seal (Prompt H). Same PRIVATE_KEY if deployer is keeper.
# From repo root: npx tsx scripts/seal-week.ts
# Pays Inco getFee() on Base mainnet 8453. Do not run from the player browser.

# --- Weekly attest + settle (Prompt I / J). Same PRIVATE_KEY.
# After Sunday 00:00 UTC, previous week only:
#   npx tsx scripts/attest-week.ts --dry-run
#   npx tsx scripts/attest-week.ts
#   npx tsx scripts/settle-week.ts --dry-run
#   npx tsx scripts/settle-week.ts
# settleWeek sends real ETH (20% treasury + leftover unused Top 10 of the 80%).
# Do not invent winners. Do not settle the current week.
# Dry-run the split with forge tests, not a fake mainnet Top 10.
