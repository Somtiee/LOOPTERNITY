# LOOPTERNITY public env — copy to `.env.local` and fill in.
# Never commit `.env.local` or private keys. Restart `npm run dev` after edits.

# Reown / WalletConnect Cloud project id (FREE: https://cloud.reown.com)
# Leave empty for injected wallets only (MetaMask, Rabby, Coinbase extension).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional READ FALLBACK RPC. The live chain is Robinhood Chain mainnet
# (4663). Primary is always the chain's public RPC; this URL is only used
# when the public RPC fails. E.g. a chain-restricted Alchemy HTTPS URL.
# Browser-visible — use a scoped key, never an admin key. Leave empty for
# public-only.
# NEXT_PUBLIC_RPC_URL=

# LOOPITERNS ERC-721 on Robinhood Chain mainnet (4663). This is the v3
# deployment (2026-09-22), e.g.
#   NEXT_PUBLIC_LOOPITERNS_ADDRESS=0xF1d6AD543a47D84d5C624f80C0F22395BF524175
# Empty / zero = mint disabled.
NEXT_PUBLIC_LOOPITERNS_ADDRESS=
# Optional fallback if mintPrice() cannot be read. Wei only, no USD.
# The live deploy's price is 400000000000000 (0.0004 ETH).
# NEXT_PUBLIC_LOOPITERNS_MINT_PRICE_WEI=400000000000000

# Server-only: private key that signs mint vouchers for /api/loopitern/voucher.
# Its public address must equal the MINT_SIGNER_ADDRESS passed to the deploy
# (the live v3 contract's mintSigner). Never prefix with NEXT_PUBLIC_, never
# commit.
# VOUCHER_SIGNER_PRIVATE_KEY=
