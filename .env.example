# LOOPTERNITY public env — copy to `.env.local` and fill in.
# Never commit `.env.local` or private keys. Restart `npm run dev` after edits.

# Reown / WalletConnect Cloud project id (FREE: https://cloud.reown.com)
# Leave empty for injected wallets only (MetaMask, Rabby, Coinbase extension).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional RPC override. Default is Robinhood Chain mainnet (4663).
# NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# LOOPITERNS ERC-721 on Robinhood Chain (4663). Empty / zero = mint disabled.
NEXT_PUBLIC_LOOPITERNS_ADDRESS=
# Optional fallback if mintPrice() cannot be read. Wei only, no USD.
# NEXT_PUBLIC_LOOPITERNS_MINT_PRICE_WEI=
