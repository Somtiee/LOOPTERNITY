# LOOPTERNITY public env — copy to `.env.local` and fill in.
# Never commit `.env.local` or private keys. Restart `npm run dev` after changes.

# Reown / WalletConnect Cloud project id (FREE: https://cloud.reown.com)
# Leave empty for injected wallets only (MetaMask, Rabby, Coinbase extension).
# Do not invent an id.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Chain: mainnet = Base production 8453 | sepolia = testnet only
NEXT_PUBLIC_CHAIN=mainnet

# RPC for the chain above.
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org

# Base mainnet LoopternityVault (8453). Production.
# Record: contracts/deployments/base-mainnet.json
# Basescan: https://basescan.org/address/0x66b549F570Fa63e3109B85FD15678c175F1a02c9
NEXT_PUBLIC_LOOPTERNITY_CONTRACT_ADDRESS=0x66b549F570Fa63e3109B85FD15678c175F1a02c9

# Vault CREATE block on Base mainnet (log scans).
NEXT_PUBLIC_VAULT_DEPLOY_BLOCK=49966576

# P2E entry fee in USD (~$0.05 per run). Display only. On-chain min is entryFeeWei
# (26701128923731 wei on mainnet).
NEXT_PUBLIC_P2E_ENTRY_FEE_USD=0.05

# Optional exact ETH amount. If set, skips the USD→ETH price fetch.
NEXT_PUBLIC_P2E_ENTRY_FEE_ETH=

# Display only. Entry ETH goes through vault enterRun, not a raw transfer.
# On-chain 20% uses contract treasury() until owner setTreasury().
NEXT_PUBLIC_P2E_TREASURY_ADDRESS=0xEacA26c65bd43803CB07319D5055bB7CF8DEC00c

# --- Base Sepolia testnet only. Do not use with NEXT_PUBLIC_CHAIN=mainnet. ---
# Same CREATE address as mainnet; different chain state and entryFeeWei.
# NEXT_PUBLIC_CHAIN=sepolia
# NEXT_PUBLIC_BASE_RPC_URL=https://sepolia.base.org
# NEXT_PUBLIC_LOOPTERNITY_CONTRACT_ADDRESS=0x66b549F570Fa63e3109B85FD15678c175F1a02c9
# NEXT_PUBLIC_P2E_TREASURY_ADDRESS=0xEacA26c65bd43803CB07319D5055bB7CF8DEC00c
# NEXT_PUBLIC_P2E_ENTRY_FEE_ETH=0.00002
